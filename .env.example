# Copy to .env and fill in. All variables are optional unless noted.

# --- workspace ---------------------------------------------------------------
MANOREM_WORKSPACE_ROOT=out
MANOREM_LOG_LEVEL=INFO
# JSON logs for workers, console rendering for humans.
MANOREM_LOG_JSON=false

# --- AI provider -------------------------------------------------------------
# gemini | cassette | stub. Default is cassette: offline, deterministic, no key.
MANOREM_LLM_PROVIDER=cassette
# The credential every tool draws in shared mode (the default).
# The older MANOREM_GEMINI_API_KEY spelling is still accepted unchanged.
MANOREM_GEMINI_APIKEY=
# shared: one credential for every tool. dedicated: one credential per tool,
# each read from its own MANOREM_<TOOL>_GEMINI_APIKEY below.
# Keys from one Gemini project share that project's quota, so per-tool
# credentials isolate workloads from each other -- they do not add quota.
# Keys from separate projects carry separate quotas, and recording bills each
# stage to its own tool, so a per-project key set spreads the spend.
MANOREM_GEMINI_KEY_MODE=shared
# Off by default: when off, a tool with no dedicated credential fails at
# startup naming its variable rather than borrowing another tool's key.
MANOREM_GEMINI_ALLOW_SHARED_FALLBACK=false
# Read only in dedicated mode. One entry per Manorem Gemini consumer:
#   cassette   - the record-mode backend behind MANOREM_AI_RECORD
#   research   - ResearchBrief | evidence - EvidenceAssessment
#   story      - StoryOutline | script - Script
#   visual_plan - VisualPlan | scene - Scene generation | repair - JSON Patch
MANOREM_CASSETTE_GEMINI_APIKEY=
MANOREM_EVIDENCE_GEMINI_APIKEY=
MANOREM_REPAIR_GEMINI_APIKEY=
MANOREM_RESEARCH_GEMINI_APIKEY=
MANOREM_SCENE_GEMINI_APIKEY=
MANOREM_SCRIPT_GEMINI_APIKEY=
MANOREM_STORY_GEMINI_APIKEY=
MANOREM_VISUAL_PLAN_GEMINI_APIKEY=
# Model ids, resolved centrally -- never at a call site.
MANOREM_GEMINI_MODEL=gemini-3.8-flash
MANOREM_GEMINI_MODEL_HEAVY=gemini-3.8-flash
MANOREM_LLM_TEMPERATURE=0.4
MANOREM_LLM_MAX_TOKENS=8192
# Set to true with a real key to refresh recorded cassettes.
MANOREM_AI_RECORD=false
MANOREM_AI_CASSETTE_DIR=tests/fixtures/cassettes

# --- repair loop -------------------------------------------------------------
# Bounded on purpose: never retry indefinitely. Shared by IR repair and
# the research/evidence repair loop.
MANOREM_MAX_REPAIR_ATTEMPTS=2

# --- research / content intelligence -----------------------------------------
# Off by default: an ordinary build never depends on a retrieval service.
# `manorem build --research` turns it on for a single run.
MANOREM_RESEARCH_ENABLED=false
# stub | cassette | brave. Only brave can reach the network, and it is never
# constructed under --offline.
MANOREM_RESEARCH_PROVIDER=stub
# Required only when MANOREM_RESEARCH_PROVIDER=brave. Never hashed, cached or
# persisted.
MANOREM_RESEARCH_API_KEY=
# MANOREM_RESEARCH_BASE_URL=
MANOREM_RESEARCH_CASSETTE_DIR=tests/fixtures/research_cassettes
# Set to true with a real key to refresh recorded research cassettes. Forced
# off under --offline.
MANOREM_RESEARCH_RECORD=false
MANOREM_RESEARCH_MAX_SOURCES=6
MANOREM_RESEARCH_CACHE=true
# How long a cached retrieval stays fresh. 0 means "reuse until it is deleted".
MANOREM_RESEARCH_CACHE_TTL_S=86400

# --- render ------------------------------------------------------------------
# draft (854x480@15) | medium (1280x720@30) | final (1920x1080@60)
MANOREM_RENDER_QUALITY=draft
MANOREM_RENDER_TIMEOUT_S=600
# Keyframe sampling rate feeding the (future) Visual QA stage.
MANOREM_FRAME_SAMPLE_HZ=1.0

# --- narration ---------------------------------------------------------------
# Placeholder pacing model until a TTS provider supplies real durations.
MANOREM_NARRATION_WPM=150
