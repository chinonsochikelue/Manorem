# Copy to .env and fill in. All variables are optional unless noted.

# --- workspace ---------------------------------------------------------------
MANOREM_WORKSPACE_ROOT=out
MANOREM_LOG_LEVEL=INFO
# JSON logs for workers, console rendering for humans.
MANOREM_LOG_JSON=false

# --- AI provider -------------------------------------------------------------
# gemini | cassette | stub. Default is cassette: offline, deterministic, no key.
MANOREM_LLM_PROVIDER=cassette
# Required only when MANOREM_LLM_PROVIDER=gemini.
MANOREM_GEMINI_API_KEY=
MANOREM_GEMINI_MODEL=gemini-3.8-flash
MANOREM_GEMINI_MODEL_HEAVY=gemini-3.8-flash
MANOREM_LLM_TEMPERATURE=0.4
MANOREM_LLM_MAX_TOKENS=8192
# Set to true with a real key to refresh recorded cassettes.
MANOREM_AI_RECORD=false
MANOREM_AI_CASSETTE_DIR=tests/fixtures/cassettes

# --- repair loop -------------------------------------------------------------
# Bounded on purpose: never retry indefinitely.
MANOREM_MAX_REPAIR_ATTEMPTS=2

# --- render ------------------------------------------------------------------
# draft (854x480@15) | medium (1280x720@30) | final (1920x1080@60)
MANOREM_RENDER_QUALITY=draft
MANOREM_RENDER_TIMEOUT_S=600
# Keyframe sampling rate feeding the (future) Visual QA stage.
MANOREM_FRAME_SAMPLE_HZ=1.0

# --- narration ---------------------------------------------------------------
# Placeholder pacing model until a TTS provider supplies real durations.
MANOREM_NARRATION_WPM=150
